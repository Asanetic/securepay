//dna options== Digital Nexus Architecture (DNA)

$dna_file_name="securepay_tatbles"; 
$create_dna="yes"; //yes | no; 
$overwrite_dna_file="yes"; //yes | no 
//dna options==

$clients_table_script = "
`primkey` int(11) PRIMARY KEY AUTO_INCREMENT,
`record_id` varchar(100) NOT NULL,

`client_name` varchar(255) NOT NULL,
`phone_number` varchar(50),
`email` varchar(255),
`national_id` varchar(100),

`created_at` datetime DEFAULT CURRENT_TIMESTAMP
";

create_table($mysqliconn, $dbname, 'clients', $clients_table_script);

$project_steps_table_script = "
`primkey` int(11) PRIMARY KEY AUTO_INCREMENT,
`record_id` varchar(100) NOT NULL,

`project_id` varchar(100) NOT NULL,

`step_name` varchar(255),
`step_status` varchar(50),
-- done, active, pending

`step_order` int(3),

`notes` text,

`created_at` datetime DEFAULT CURRENT_TIMESTAMP
";

create_table($mysqliconn, $dbname, 'project_steps', $project_steps_table_script);


$payments_table_script = "
`primkey` int(11) PRIMARY KEY AUTO_INCREMENT,
`record_id` varchar(100) NOT NULL,

`project_id` varchar(100),
`client_id` varchar(100),

`amount` decimal(10,2),
`payment_method` varchar(50),
-- mpesa, card, etc

`transaction_code` varchar(100),

`payer_name` varchar(255),
`payer_phone` varchar(50),

`status` varchar(50),
-- pending, completed, failed, locked, released

`paid_at` datetime,
`created_at` datetime DEFAULT CURRENT_TIMESTAMP
";

create_table($mysqliconn, $dbname, 'payments', $payments_table_script);


$tasks_table_script = "
`primkey` int(11) PRIMARY KEY AUTO_INCREMENT,
`record_id` varchar(100) NOT NULL,

`project_id` varchar(100),

`task_name` varchar(255),
`task_status` varchar(50),
-- pending, active, done

`assigned_to` varchar(100),

`priority` varchar(50),
-- low, medium, high

`due_date` datetime,

`created_at` datetime DEFAULT CURRENT_TIMESTAMP
";

create_table($mysqliconn, $dbname, 'tasks', $tasks_table_script);


$documents_table_script = "
`primkey` int(11) PRIMARY KEY AUTO_INCREMENT,
`record_id` varchar(100) NOT NULL,

`project_id` varchar(100),
`client_id` varchar(100),

`doc_type` varchar(50),
-- receipt, agreement, invoice

`file_url` text,

`status` varchar(50),
-- available, pending

`created_at` datetime DEFAULT CURRENT_TIMESTAMP
";

create_table($mysqliconn, $dbname, 'documents', $documents_table_script);


$activity_table_script = "
`primkey` int(11) PRIMARY KEY AUTO_INCREMENT,
`record_id` varchar(100) NOT NULL,

`project_id` varchar(100),

`activity_type` varchar(100),
-- payment_completed, funds_locked, dev_started etc

`description` text,

`created_at` datetime DEFAULT CURRENT_TIMESTAMP
";

create_table($mysqliconn, $dbname, 'project_activity', $activity_table_script);



$projects_table_script = "
`primkey` int(11) PRIMARY KEY AUTO_INCREMENT,
`record_id` varchar(100) NOT NULL,

`client_id` varchar(100) NOT NULL,

`project_name` varchar(255),
`project_ref` varchar(100),

`amount` decimal(10,2),
`currency` varchar(10) DEFAULT 'KES',

`status` varchar(50), 
-- pending, paid, active, completed

`progress_percent` int(3) DEFAULT 0,

`created_at` datetime DEFAULT CURRENT_TIMESTAMP
";

create_table($mysqliconn, $dbname, 'projects', $projects_table_script);

